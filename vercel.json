{
  "version": 2,                    // Vercel config version
  "builds": [
    {
      "src": "claude.js",           // Tell Vercel: "this is a Node.js file"
      "use": "@vercel/node"         // Use Node.js runtime to run it
    }
  ],
  "routes": [
    {
      "src": "/api/chat",           // When someone visits /api/chat
      "dest": "/claude.js"          // Send them to claude.js
    },
    {
      "src": "/(.*)",               // Everything else (like .html, .css)
      "dest": "/public/$1"          // Serve from public folder
    }
  ]
}
